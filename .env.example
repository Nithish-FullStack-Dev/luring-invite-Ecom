# Preserve your existing PostgreSQL configuration. Examples only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Exact browser origin. Production: https://outrightsluringinvite.com
CMS_ORIGIN="http://localhost:3000"
CMS_ADMIN_EMAIL="admin@example.com"
# Supply a unique password of 15–128 characters securely.
CMS_ADMIN_PASSWORD=""

# Optional: isolated automated tests; use a test database with schema creation rights.
CMS_TEST_DATABASE_URL=""

# Optional paths when FFmpeg tools are not on PATH.
FFMPEG_PATH=""
FFPROBE_PATH=""
MAX_RENDER_SECONDS="180"

# Razorpay: keep these server-side secrets out of source control.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
