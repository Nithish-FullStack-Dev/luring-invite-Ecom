generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VideoJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Category {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  parentId  String?
  parent    Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]         @relation("CategoryTree")
  templates TemplateCategory[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([parentId])
}

model Template {
  id                      Int                @id @default(autoincrement())
  title                   String
  slug                    String             @unique
  description             String?            @db.Text
  thumbnail               String?
  previewVideo            String?
  sourceVideo             String?
  price                   Decimal            @default(299.00) @db.Decimal(10, 2)
  durationSeconds         Int                @default(0)
  active                  Boolean            @default(true)
  musicConfigured         Boolean            @default(false)
  musicTracks             MusicTrack[]       @relation("TemplateMusic")
  legacyPlaceholderConfig Json?
  categories              TemplateCategory[]
  frames                  TemplateFrame[]
  videoJobs               VideoJob[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  cartItem CartItem[]

  @@index([active, createdAt])
}

model TemplateCategory {
  templateId Int
  categoryId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([templateId, categoryId])
  @@index([categoryId])
}

model TemplateFrame {
  id                Int      @id @default(autoincrement())
  templateId        Int
  frameNumber       Int
  title             String?
  sourceVideo       String?
  previewImage      String?
  placeholderConfig Json
  durationSeconds   Int?
  template          Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([templateId, frameNumber])
  @@index([templateId, frameNumber])
}

model MusicTrack {
  id        String     @id @default(cuid())
  title     String     @unique
  path      String     @unique
  duration  Int?
  enabled   Boolean    @default(true)
  templates Template[] @relation("TemplateMusic")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([enabled, title])
}

model VideoJob {
  id         String         @id @default(cuid())
  templateId Int
  status     VideoJobStatus @default(PENDING)
  input      Json
  outputPath String?
  error      String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  template   Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
  @@index([status, createdAt])
}

model CmsAdmin {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     CmsSession[]
}

model CmsSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  admin     CmsAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model CmsLoginLimit {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

enum CmsContentStatus {
  DRAFT
  PUBLISHED
}

model CmsContent {
  id        String           @id @default(cuid())
  title     String
  key       String           @unique
  type      String
  content   Json
  status    CmsContentStatus @default(DRAFT)
  version   Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status, key])
}

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      CartUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CartUser {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts    Cart[]
  sessions UserSession[]

  @@index([createdAt])
}

model Cart {
  id String @id @default(cuid())

  userId String?
  user   CartUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  guestId String? @unique

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model CartItem {
  id         String @id @default(cuid())
  cartId     String
  templateId Int
  quantity   Int    @default(1)

  unitPrice Decimal @db.Decimal(10, 2)

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, templateId])
  @@index([templateId])
}
